<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.uoquo.platform.system.mapper.AppPermissionMapper">

  <resultMap id="BaseResultMap" type="com.uoquo.platform.system.model.pojo.AppPermission">
    <id column="id" jdbcType="VARCHAR" property="id" />
    <result column="app_id" jdbcType="VARCHAR" property="appId" />
    <result column="resource_id" jdbcType="VARCHAR" property="resourceId" />
  </resultMap>

  <sql id="Base_Column_List">
    id, app_id, resource_id
  </sql>

  <insert id="insert" parameterType="com.uoquo.platform.system.model.pojo.AppPermission">
    INSERT INTO bko_app_permission (id, app_id, resource_id)
    VALUES (#{id,jdbcType=VARCHAR}, #{appId,jdbcType=VARCHAR}, #{resourceId,jdbcType=VARCHAR})
  </insert>

  <insert id="batchInsert" parameterType="java.util.List">
    INSERT INTO bko_app_permission (id, app_id, resource_id) VALUES
    <foreach collection="list" item="item" separator=",">
      (#{item.id,jdbcType=VARCHAR}, #{item.appId,jdbcType=VARCHAR}, #{item.resourceId,jdbcType=VARCHAR})
    </foreach>
  </insert>

  <delete id="deleteByPrimaryKey" parameterType="java.lang.String">
    DELETE FROM bko_app_permission
    WHERE id = #{id,jdbcType=VARCHAR}
  </delete>

  <delete id="deleteByAppId" parameterType="java.lang.String">
    DELETE FROM bko_app_permission
    WHERE app_id = #{appId,jdbcType=VARCHAR}
  </delete>

  <delete id="deleteByResourceId" parameterType="java.lang.String">
    DELETE FROM bko_app_permission
    WHERE resource_id = #{resourceId,jdbcType=VARCHAR}
  </delete>

  <select id="selectByPrimaryKey" parameterType="java.lang.String" resultMap="BaseResultMap">
    SELECT
    <include refid="Base_Column_List" />
    FROM bko_app_permission
    WHERE id = #{id,jdbcType=VARCHAR}
  </select>

  <select id="selectByAppId" parameterType="java.lang.String" resultMap="BaseResultMap">
    SELECT
    <include refid="Base_Column_List" />
    FROM bko_app_permission
    WHERE app_id = #{appId,jdbcType=VARCHAR}
  </select>
</mapper>