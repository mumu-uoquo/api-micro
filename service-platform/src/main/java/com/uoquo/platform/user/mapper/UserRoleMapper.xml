<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.uoquo.platform.user.mapper.UserRoleMapper">

  <resultMap id="BaseResultMap" type="com.uoquo.platform.user.model.pojo.UserRole">
    <id column="id" jdbcType="VARCHAR" property="id" />
    <result column="user_id" jdbcType="VARCHAR" property="userId" />
    <result column="role_id" jdbcType="VARCHAR" property="roleId" />
  </resultMap>

  <sql id="Base_Column_List">
    id, user_id, role_id
  </sql>

  <insert id="insert" parameterType="com.uoquo.platform.user.model.pojo.UserRole">
    INSERT INTO bko_user_role (id, user_id, role_id)
    VALUES (#{id,jdbcType=VARCHAR}, #{userId,jdbcType=VARCHAR}, #{groupId,jdbcType=VARCHAR})
  </insert>

  <insert id="batchInsert" parameterType="java.util.List">
    INSERT INTO bko_user_role (id, user_id, role_id) VALUES
    <foreach collection="list" item="item" separator=",">
      (#{item.id,jdbcType=VARCHAR}, #{item.userId,jdbcType=VARCHAR}, #{item.roleId,jdbcType=VARCHAR})
    </foreach>
  </insert>

  <delete id="deleteByUserId" parameterType="java.lang.String">
    DELETE FROM bko_user_role
    WHERE user_id = #{userId,jdbcType=VARCHAR}
  </delete>

  <select id="selectByUserId" parameterType="java.lang.String" resultMap="BaseResultMap">
    SELECT
    <include refid="Base_Column_List" />
    FROM bko_user_role
    WHERE user_id = #{userId,jdbcType=VARCHAR}
  </select>

  <delete id="deleteByRoleId" parameterType="java.lang.String">
    DELETE FROM bko_user_role
    WHERE role_id = #{roleId,jdbcType=VARCHAR}
  </delete>

  <select id="selectByRoleId" parameterType="java.lang.String" resultMap="BaseResultMap">
    SELECT
    <include refid="Base_Column_List" />
    FROM bko_user_role
    WHERE role_id = #{roleId,jdbcType=VARCHAR}
  </select>
</mapper>